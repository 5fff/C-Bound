# C-Bound Production Environment Configuration
# Copy this file to .env and modify the values below for deployment

# ============================================================================
# SERVER BINDING
# ============================================================================
# The port the Node server listens on
PORT=3000

# Bind address. 
# Use 127.0.0.1 if deploying behind a local reverse proxy (e.g. NGINX, Cloudflare Tunnels). 
# Use 0.0.0.0 for direct public access.
HOST=0.0.0.0

# The minimum required number of WebSocket ping/pong challenges before evaluation
MIN_ROUNDS=3

# The absolute maximum number of challenge rounds permitted before forced verification failure
MAX_ROUNDS=10


# ============================================================================
# PERSISTENCE
# ============================================================================
# Path where the server saves dynamic targets and threshold configurations
# Setting this ensures configurations survive an application restart
DATA_FILE_PATH=./data/cbound_config.json


# ============================================================================
# APPLICATION SECRETS
# ============================================================================
# A strong, randomly generated passphrase to protect the Admin and Field Test Panels
# e.g., Generate one using: openssl rand -base64 32
CONFIG_SECRET=secretstring123


# ============================================================================
# PROXY SECURITY
# ============================================================================
# Set to 'true' ONLY if the server sits behind a trusted reverse proxy (like Cloudflare Tunnels).
# This allows C-Bound to safely extract the true client IP from X-Forwarded-For headers.
TRUST_PROXY=false


# ============================================================================
# DEFAULTS
# ============================================================================
# The default target URL if a user requests a Short ID that doesn't exist
TARGET_URL=https://google.com/

# The default global Honeypot URL for users who fail the proximity check
HONEYPOT_URL=https://youtube.com/

# Whether the Honeypot redirection is enabled globally by default (true/false)
HONEYPOT_ENABLED=true

# Default latency verification threshold in milliseconds (Sub 2ms = local network)
LATENCY_THRESHOLD_MS=2

# Enable QR Mode by default for all newly created targets.
# When true, verified clients are presented with a scannable QR code rather than being automatically redirected.
GLOBAL_QR_MODE=false
